<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark from the first frame: the launch splash and the page behind the game share the game's background. -->
    <style name="KardashevTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="android:colorBackground">@color/backgroundColor</item>
        <item name="android:statusBarColor">@color/backgroundColor</item>
        <item name="android:navigationBarColor">@color/backgroundColor</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
