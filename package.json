{
  "name": "kardashev-project",
  "private": true,
  "version": "1.0.0",
  "description": "A cozy-but-real 3D management sim about the AI boom: guide Earth up the Kardashev scale.",
  "author": "Lone Fox <contact@ame-apexforge.org>",
  "homepage": "https://thekardashevproject.netlify.app",
  "desktopName": "kardashev-project.desktop",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:site": "tsc --noEmit && KP_TARGET=site vite build",
    "preview:site": "KP_TARGET=site vite preview --outDir dist-site",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:map": "node tools/gen-worldmap.mjs",
    "gen:assets": "tsx tools/gen-assets.ts",
    "desktop:dev": "node electron/dev.mjs",
    "desktop:build": "npm run build && electron-builder --publish never",
    "desktop:build:steam": "KP_STEAM=1 npm run build && KP_STEAM=1 electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2"
  }
}
